# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials.
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/medical_cdss?retryWrites=true&w=majority&appName=MedicalCDSS
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/medical_cdss?retryWrites=true&w=majority

# JWT Authentication Secret (use a long random string in production)
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=12h

# CORS Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Optional Invite Code for registering Authorized Medical Expert / Admin accounts
# Leave blank to disable self-registration of medical experts (use `npm run promote-expert -- <email>` instead)
EXPERT_REGISTRATION_CODE=CDSS-EXPERT-2026
